{
  "name": "dsh-mvp-xiaohutem",
  "version": "1.1.0",
  "type": "module",
  "description": "MVP Dev Expert Team for DeepSeek Harness: 8 standard roles plus a conditional reverse-engineering role, phased SOP, 31 knowledge-base references, gate tools, agent preset and a phase board.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "skills/*.md",
    "agents/*.md",
    "references/**/*.md",
    "assets/*",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hgc357341051/dsh-mvp-xiaohuTem.git"
  },
  "keywords": ["dsh", "cordis", "mvp", "agent-team", "reverse-engineering"]
}
